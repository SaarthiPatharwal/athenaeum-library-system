<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Athenaeum — Library Catalog</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:        #1C2321;   /* near-black pine, primary text & dark surfaces */
    --forest:     #2F4A3D;   /* deep green, header / nav surfaces          */
    --parchment:  #F3E9D3;   /* warm aged paper, page background            */
    --card:       #FBF6EA;   /* lighter card surface, sits on parchment     */
    --brass:      #AD8A4E;   /* gilding accent, primary interactive color   */
    --brass-dark: #8C6E38;
    --moss:       #5C7A56;   /* available / success                        */
    --burgundy:   #7A3030;   /* issued out / destructive                   */
    --rule:       rgba(28,35,33,0.16);
    --shadow:     0 6px 18px rgba(28,35,33,0.10);
    --shadow-lg:  0 14px 32px rgba(28,35,33,0.16);
  }

  *{ box-sizing: border-box; }
  html{ scroll-behavior: smooth; }

  body{
    margin:0;
    background:
      radial-gradient(1200px 500px at 10% -10%, rgba(173,138,78,0.10), transparent),
      var(--parchment);
    color: var(--ink);
    font-family: 'Source Sans 3', sans-serif;
    line-height: 1.5;
  }

  h1, h2, h3, .display{
    font-family: 'Fraunces', serif;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .mono{ font-family: 'IBM Plex Mono', monospace; }

  a{ color: inherit; }

  /* ============================= HEADER / DRAWER TABS ============================= */
  .site-header{
    background: var(--forest);
    padding: 0 clamp(16px, 4vw, 48px);
  }
  .header-top{
    max-width: 1180px;
    margin: 0 auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding: 20px 0 0;
  }
  .brand{
    display:flex;
    align-items:baseline;
    gap:10px;
    color: #F6F1E4;
  }
  .brand .mark{
    font-family:'Fraunces', serif;
    font-weight:700;
    font-size: 1.7rem;
  }
  .brand .sub{
    font-family:'IBM Plex Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(246,241,228,0.6);
  }
  .drawer-nav{
    max-width: 1180px;
    margin: 14px auto 0;
    display:flex;
    gap:6px;
  }
  .drawer-tab{
    font-family:'IBM Plex Mono', monospace;
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-decoration:none;
    color: #F6F1E4;
    background: rgba(246,241,228,0.08);
    border: 1px solid rgba(246,241,228,0.18);
    border-bottom: none;
    padding: 9px 18px 10px;
    border-radius: 6px 6px 0 0;
    transform: translateY(1px);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .drawer-tab:hover{ background: var(--brass); color: var(--ink); border-color: var(--brass); }
  .header-shelf{
    max-width: 1180px;
    margin: 0 auto;
    height: 4px;
    background: linear-gradient(90deg, var(--brass), var(--brass-dark));
    border-radius: 2px 2px 0 0;
  }

  .wrap{ max-width: 1180px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 48px); }

  /* ============================= HERO ============================= */
  .hero{
    padding: clamp(48px, 8vw, 88px) 0 clamp(32px, 5vw, 56px);
    border-bottom: 1px solid var(--rule);
  }
  .hero .eyebrow{
    font-family:'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass-dark);
    margin-bottom: 14px;
  }
  .hero h1{
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    max-width: 15ch;
    line-height: 1.06;
  }
  .hero p{
    max-width: 56ch;
    font-size: 1.08rem;
    color: rgba(28,35,33,0.78);
    margin-top: 18px;
  }
  .stat-strip{
    display:flex;
    flex-wrap: wrap;
    gap: clamp(24px, 4vw, 56px);
    margin-top: 40px;
  }
  .stat{ min-width: 120px; }
  .stat .num{
    font-family:'IBM Plex Mono', monospace;
    font-size: 2.1rem;
    font-weight: 600;
    color: var(--forest);
  }
  .stat .label{
    font-size: 0.82rem;
    color: rgba(28,35,33,0.6);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ============================= SECTIONS ============================= */
  section.block{ padding: clamp(40px, 6vw, 64px) 0; }
  .block-head{
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    gap: 20px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }
  .block-head h2{ font-size: clamp(1.5rem, 3vw, 2rem); }
  .block-head .tag{
    font-family:'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brass-dark);
  }

  /* ============================= TOOLBAR ============================= */
  .toolbar{
    display:flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .field{
    display:flex;
    flex-direction:column;
    gap:6px;
  }
  .field label{
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(28,35,33,0.55);
  }
  input, select{
    font-family:'Source Sans 3', sans-serif;
    font-size: 0.95rem;
    padding: 10px 12px;
    border-radius: 7px;
    border: 1px solid rgba(28,35,33,0.22);
    background: var(--card);
    color: var(--ink);
  }
  input:focus, select:focus, button:focus-visible{
    outline: 2px solid var(--brass);
    outline-offset: 1px;
  }
  #search-input{ min-width: 240px; flex: 1; }

  button{
    font-family:'Source Sans 3', sans-serif;
    font-weight: 600;
    font-size: 0.9rem;
    border: none;
    border-radius: 7px;
    padding: 10px 16px;
    cursor: pointer;
    transition: transform 0.08s ease, box-shadow 0.15s ease, background 0.15s ease;
  }
  button:active{ transform: translateY(1px); }
  .btn-primary{ background: var(--brass); color: var(--ink); }
  .btn-primary:hover{ background: var(--brass-dark); color: #fff; }
  .btn-ghost{
    background: transparent;
    border: 1px solid rgba(28,35,33,0.28);
    color: var(--ink);
  }
  .btn-ghost:hover{ border-color: var(--ink); }
  .btn-issue{ background: var(--moss); color:#fff; }
  .btn-issue:hover{ background:#4a6544; }
  .btn-issue:disabled{ background:#c9cdc6; color:#8a8f86; cursor:not-allowed; }
  .btn-return{ background: var(--forest); color:#F6F1E4; }
  .btn-return:hover{ background:#22362c; }
  .btn-return:disabled{ background:#c9cdc6; color:#8a8f86; cursor:not-allowed; }
  .btn-delete{ background: transparent; color: var(--burgundy); border:1px solid rgba(122,48,48,0.4); }
  .btn-delete:hover{ background: rgba(122,48,48,0.08); }

  /* ============================= CATALOG GRID / INDEX CARDS ============================= */
  #catalog-grid{
    display:grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }
  .book-card{
    position:relative;
    background: var(--card);
    border-radius: 10px;
    box-shadow: var(--shadow);
    padding: 22px 18px 18px;
    border: 1px solid rgba(28,35,33,0.08);
    animation: rise 0.4s ease both;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .book-card:hover{ box-shadow: var(--shadow-lg); transform: translateY(-2px); }
  @keyframes rise{ from{ opacity:0; transform: translateY(8px);} to{opacity:1; transform:translateY(0);} }

  .book-card::before{
    /* punched card-catalog hole */
    content:"";
    position:absolute;
    top: -7px; left: 50%;
    transform: translateX(-50%);
    width: 14px; height:14px;
    background: var(--parchment);
    border: 1px solid rgba(28,35,33,0.18);
    border-radius: 50%;
  }
  .call-number{
    font-family:'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    color: var(--brass-dark);
    letter-spacing: 0.05em;
    border-bottom: 1px dashed var(--rule);
    padding-bottom: 8px;
    margin-bottom: 12px;
    display:flex;
    justify-content: space-between;
  }
  .book-title{
    font-size: 1.15rem;
    line-height:1.25;
    margin-bottom: 4px;
  }
  .book-author{
    font-style: italic;
    color: rgba(28,35,33,0.7);
    font-size: 0.92rem;
    margin-bottom: 14px;
  }
  .book-meta{
    display:flex;
    justify-content: space-between;
    align-items:center;
    font-size: 0.82rem;
    color: rgba(28,35,33,0.7);
    margin-bottom: 14px;
  }
  .status-pill{
    font-family:'IBM Plex Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    padding: 3px 9px;
    border-radius: 999px;
    text-transform: uppercase;
  }
  .status-pill.available{ background: rgba(92,122,86,0.15); color: var(--moss); }
  .status-pill.out{ background: rgba(122,48,48,0.14); color: var(--burgundy); }
  .card-actions{ display:flex; gap:8px; flex-wrap: wrap; }
  .card-actions button{ flex:1; min-width: 80px; font-size: 0.82rem; padding: 8px 10px; }

  .empty-state{
    grid-column: 1 / -1;
    text-align:center;
    padding: 48px 20px;
    color: rgba(28,35,33,0.6);
    border: 1px dashed var(--rule);
    border-radius: 10px;
    background: rgba(251,246,234,0.5);
  }

  /* ============================= ADD BOOK SLIP ============================= */
  #add{ border-top: 1px solid var(--rule); }
  .slip{
    background: var(--card);
    border-radius: 12px;
    box-shadow: var(--shadow);
    padding: 28px clamp(20px, 4vw, 36px);
    border: 1px solid rgba(28,35,33,0.08);
    max-width: 720px;
  }
  .slip-grid{
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .slip-grid .field.full{ grid-column: 1 / -1; }
  @media (max-width: 560px){ .slip-grid{ grid-template-columns: 1fr; } }
  .slip-footer{
    display:flex;
    align-items:center;
    justify-content: space-between;
    margin-top: 20px;
    gap: 16px;
    flex-wrap: wrap;
  }
  #form-message{
    font-size: 0.86rem;
    min-height: 1.2em;
  }
  #form-message.error{ color: var(--burgundy); }
  #form-message.ok{ color: var(--moss); }

  /* ============================= TOAST ============================= */
  #toast{
    position: fixed;
    bottom: 22px; left:50%;
    transform: translateX(-50%) translateY(20px);
    background: var(--ink);
    color: #F6F1E4;
    padding: 12px 20px;
    border-radius: 8px;
    font-size: 0.88rem;
    box-shadow: var(--shadow-lg);
    opacity:0;
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events:none;
    z-index: 50;
  }
  #toast.show{ opacity:1; transform: translateX(-50%) translateY(0); }

  /* ============================= FOOTER ============================= */
  footer{
    border-top: 1px solid var(--rule);
    padding: 32px 0 48px;
  }
  .stamp{
    display:inline-flex;
    align-items:center;
    gap:10px;
    font-family:'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: rgba(28,35,33,0.55);
    text-transform: uppercase;
  }
  .stamp .ring{
    width: 30px; height:30px;
    border-radius:50%;
    border: 2px solid var(--brass-dark);
    display:flex; align-items:center; justify-content:center;
    color: var(--brass-dark);
    font-family:'Fraunces', serif;
    font-weight:700;
    font-size: 0.9rem;
  }

  @media (prefers-reduced-motion: reduce){
    html{ scroll-behavior:auto; }
    .book-card{ animation:none; }
    * { transition:none !important; }
  }
</style>
</head>
<body>

  <header class="site-header">
    <div class="header-top">
      <div class="brand">
        <span class="mark">Athenaeum</span>
        <span class="sub">Library Catalog</span>
      </div>
    </div>
    <nav class="drawer-nav">
      <a class="drawer-tab" href="#catalog">Catalog</a>
      <a class="drawer-tab" href="#add">Add a Book</a>
      <a class="drawer-tab" href="#about">Guide</a>
    </nav>
    <div class="header-shelf"></div>
  </header>

  <main>
    <section class="hero wrap">
      <div class="eyebrow">Reading Room · Est. Local Branch</div>
      <h1>A place for every book, and every book in its place.</h1>
      <p>Athenaeum keeps a small library's collection, loans, and returns in one tidy shelf — searchable, sortable, and ready for the next reader at the desk.</p>
      <div class="stat-strip">
        <div class="stat">
          <div class="num" id="stat-titles">0</div>
          <div class="label">Titles catalogued</div>
        </div>
        <div class="stat">
          <div class="num" id="stat-copies">0</div>
          <div class="label">Copies on shelf</div>
        </div>
        <div class="stat">
          <div class="num" id="stat-issued">0</div>
          <div class="label">Currently on loan</div>
        </div>
      </div>
    </section>

    <section class="block wrap" id="catalog">
      <div class="block-head">
        <h2>The Catalog</h2>
        <span class="tag" id="result-count">— titles</span>
      </div>

      <div class="toolbar">
        <div class="field" style="flex:1;">
          <label for="search-input">Search</label>
          <input id="search-input" type="text" placeholder="Search by title, author, or ISBN…" autocomplete="off">
        </div>
        <div class="field">
          <label for="sort-select">Sort by</label>
          <select id="sort-select">
            <option value="title">Title</option>
            <option value="author">Author</option>
            <option value="id">Recently added</option>
          </select>
        </div>
      </div>

      <div id="catalog-grid"></div>
    </section>

    <section class="block wrap" id="add">
      <div class="block-head">
        <h2>Add a Book</h2>
        <span class="tag">New Accession Slip</span>
      </div>
      <form class="slip" id="add-form" novalidate>
        <div class="slip-grid">
          <div class="field full">
            <label for="f-title">Title</label>
            <input id="f-title" type="text" placeholder="e.g. Dune" required>
          </div>
          <div class="field">
            <label for="f-author">Author</label>
            <input id="f-author" type="text" placeholder="e.g. Frank Herbert" required>
          </div>
          <div class="field">
            <label for="f-isbn">ISBN</label>
            <input id="f-isbn" type="text" placeholder="e.g. 9780441172719" required>
          </div>
          <div class="field">
            <label for="f-qty">Copies</label>
            <input id="f-qty" type="number" min="1" value="1" required>
          </div>
        </div>
        <div class="slip-footer">
          <span id="form-message"></span>
          <button type="submit" class="btn-primary">Add to catalog</button>
        </div>
      </form>
    </section>

    <section class="block wrap" id="about">
      <div class="block-head"><h2>How it works</h2></div>
      <p style="max-width:64ch; color:rgba(28,35,33,0.78);">
        Every title gets a call number the moment it's added. Issuing a copy quietly reduces what's left on the shelf;
        returning one brings it back. When a title reaches zero, its status flips to <em>out on loan</em> and the
        Issue button steps aside until a copy comes home. This page keeps everything in memory for the session —
        reload the page and the shelf resets to its starting collection.
      </p>
    </section>
  </main>

  <footer class="wrap">
    <div class="stamp">
      <span class="ring">A</span>
      Athenaeum · a small-library catalog
    </div>
  </footer>

  <div id="toast"></div>

<script>
(function(){
  "use strict";

  /* =====================================================================
   * STATE
   * All book records live in a single in-memory array for the session.
   * Each record: { id, title, author, isbn, total, available }
   * ===================================================================== */
  let nextId = 1;
  const books = [];

  function seed(title, author, isbn, total, available){
    books.push({ id: nextId++, title, author, isbn, total, available: available === undefined ? total : available });
  }

  seed("Dune", "Frank Herbert", "9780441172719", 3, 1);
  seed("1984", "George Orwell", "9780451524935", 4, 4);
  seed("The Hobbit", "J.R.R. Tolkien", "9780547928227", 2, 0);
  seed("To Kill a Mockingbird", "Harper Lee", "9780061120084", 3, 2);
  seed("Sapiens", "Yuval Noah Harari", "9780062316097", 2, 2);
  seed("Clean Code", "Robert C. Martin", "9780132350884", 2, 1);
  seed("The Pragmatic Programmer", "David Thomas & Andrew Hunt", "9780135957059", 2, 0);
  seed("Pride and Prejudice", "Jane Austen", "9780141439518", 3, 3);

  /* =====================================================================
   * DOM REFERENCES
   * ===================================================================== */
  const grid = document.getElementById('catalog-grid');
  const searchInput = document.getElementById('search-input');
  const sortSelect = document.getElementById('sort-select');
  const resultCount = document.getElementById('result-count');
  const statTitles = document.getElementById('stat-titles');
  const statCopies = document.getElementById('stat-copies');
  const statIssued = document.getElementById('stat-issued');
  const addForm = document.getElementById('add-form');
  const formMessage = document.getElementById('form-message');
  const toast = document.getElementById('toast');

  let toastTimer = null;
  function showToast(text){
    toast.textContent = text;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('show'), 2600);
  }

  function escapeHtml(str){
    return String(str)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  /* =====================================================================
   * STATS
   * ===================================================================== */
  function renderStats(){
    const totalCopies = books.reduce((sum, b) => sum + b.total, 0);
    const issued = books.reduce((sum, b) => sum + (b.total - b.available), 0);
    statTitles.textContent = books.length;
    statCopies.textContent = totalCopies;
    statIssued.textContent = issued;
  }

  /* =====================================================================
   * CATALOG RENDERING (search + sort)
   * ===================================================================== */
  function getVisibleBooks(){
    const query = searchInput.value.trim().toLowerCase();
    const sortBy = sortSelect.value;

    let list = books.filter(b => {
      if (!query) return true;
      return b.title.toLowerCase().includes(query) ||
             b.author.toLowerCase().includes(query) ||
             b.isbn.toLowerCase().includes(query);
    });

    list = list.slice().sort((a, b) => {
      if (sortBy === 'title')  return a.title.localeCompare(b.title);
      if (sortBy === 'author') return a.author.localeCompare(b.author);
      return b.id - a.id; // "Recently added" — highest id first
    });

    return list;
  }

  function renderCatalog(){
    const visible = getVisibleBooks();
    resultCount.textContent = visible.length + (visible.length === 1 ? " title" : " titles");

    if (visible.length === 0){
      grid.innerHTML = '<div class="empty-state">No matches on the shelf. Try another search, or add this title below.</div>';
      return;
    }

    grid.innerHTML = visible.map(renderCard).join('');
  }

  function renderCard(b){
    const isAvailable = b.available > 0;
    const statusClass = isAvailable ? 'available' : 'out';
    const statusText = isAvailable ? 'Available' : 'On loan';
    return `
      <article class="book-card">
        <div class="call-number">
          <span>ISBN ${escapeHtml(b.isbn)}</span>
          <span>#${String(b.id).padStart(3, '0')}</span>
        </div>
        <h3 class="book-title">${escapeHtml(b.title)}</h3>
        <div class="book-author">${escapeHtml(b.author)}</div>
        <div class="book-meta">
          <span>${b.available} of ${b.total} copies free</span>
          <span class="status-pill ${statusClass}">${statusText}</span>
        </div>
        <div class="card-actions">
          <button class="btn-issue" data-action="issue" data-id="${b.id}" ${isAvailable ? '' : 'disabled'}>Issue</button>
          <button class="btn-return" data-action="return" data-id="${b.id}" ${b.available < b.total ? '' : 'disabled'}>Return</button>
          <button class="btn-delete" data-action="delete" data-id="${b.id}">Remove</button>
        </div>
      </article>
    `;
  }

  function renderAll(){
    renderStats();
    renderCatalog();
  }

  /* =====================================================================
   * ACTIONS: issue, return, delete (delegated from the grid)
   * ===================================================================== */
  grid.addEventListener('click', function(e){
    const btn = e.target.closest('button[data-action]');
    if (!btn) return;

    const id = Number(btn.dataset.id);
    const book = books.find(x => x.id === id);
    if (!book) return;

    const action = btn.dataset.action;

    if (action === 'issue'){
      if (book.available <= 0){
        showToast(`No copies of "${book.title}" are available right now.`);
        return;
      }
      book.available -= 1;
      showToast(`Issued "${book.title}" — ${book.available} left on the shelf.`);
    }
    else if (action === 'return'){
      if (book.available >= book.total){
        showToast(`All copies of "${book.title}" are already on the shelf.`);
        return;
      }
      book.available += 1;
      showToast(`"${book.title}" returned — welcome back.`);
    }
    else if (action === 'delete'){
      const idx = books.findIndex(x => x.id === id);
      if (idx !== -1){
        books.splice(idx, 1);
        showToast(`Removed "${book.title}" from the catalog.`);
      }
    }

    renderAll();
  });

  /* =====================================================================
   * SEARCH & SORT LISTENERS
   * ===================================================================== */
  searchInput.addEventListener('input', renderCatalog);
  sortSelect.addEventListener('change', renderCatalog);

  /* =====================================================================
   * ADD BOOK FORM
   * ===================================================================== */
  addForm.addEventListener('submit', function(e){
    e.preventDefault();

    const title = document.getElementById('f-title').value.trim();
    const author = document.getElementById('f-author').value.trim();
    const isbn = document.getElementById('f-isbn').value.trim();
    const qty = parseInt(document.getElementById('f-qty').value, 10);

    formMessage.className = '';
    formMessage.textContent = '';

    if (!title || !author || !isbn){
      formMessage.textContent = 'Please fill in title, author, and ISBN.';
      formMessage.className = 'error';
      return;
    }
    if (!Number.isFinite(qty) || qty < 1){
      formMessage.textContent = 'Copies must be a whole number of at least 1.';
      formMessage.className = 'error';
      return;
    }
    if (books.some(b => b.isbn.toLowerCase() === isbn.toLowerCase())){
      formMessage.textContent = `A book with ISBN ${isbn} is already in the catalog.`;
      formMessage.className = 'error';
      return;
    }

    seed(title, author, isbn, qty, qty);
    formMessage.textContent = `"${title}" added to the catalog.`;
    formMessage.className = 'ok';
    addForm.reset();
    document.getElementById('f-qty').value = 1;
    renderAll();
    showToast(`"${title}" is now on the shelf.`);
  });

  /* =====================================================================
   * INITIAL RENDER
   * ===================================================================== */
  renderAll();
})();
</script>
</body>
</html>
